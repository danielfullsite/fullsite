{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullsite.mx/schemas/client-manifest.schema.json",
  "title": "Fullsite Client Manifest",
  "description": "Schema estricto para manifests de cliente (scripts/manifests/*.json), consumidos por scripts/bootstrap_client.py. Contrato espejo de dashboard-app/src/lib/restaurant-manifest.ts (RestaurantManifest). Gate R2-G03 / CLON-MANIFEST. Claves desconocidas se rechazan: si el manifest aprende un campo nuevo, este schema y restaurant-manifest.ts deben actualizarse en el mismo commit.",
  "type": "object",
  "required": [
    "client_id",
    "display_name",
    "type",
    "city",
    "timezone",
    "plan",
    "features",
    "support_email",
    "staff"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "type": "string",
      "description": "Claves de metadata/comentario (_note, _comment) — ignoradas por bootstrap_client.py"
    }
  },
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Slug único del tenant. Minúsculas, dígitos y guiones. PK lógica en la tabla clients."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+)+$",
      "description": "Zona IANA, ej. America/Monterrey"
    },
    "plan": {
      "enum": ["reporteador", "fullsite_software", "fullsite_completo"],
      "description": "Debe coincidir con el union type de RestaurantManifest.plan"
    },
    "features": {
      "type": "object",
      "required": ["pos"],
      "additionalProperties": false,
      "properties": {
        "pos": { "type": "boolean" },
        "posRestaurant": { "type": "boolean" },
        "posTienda": { "type": "boolean" },
        "bakery_station": { "type": "boolean" },
        "delivery": { "type": "boolean" },
        "ecommerce": { "type": "boolean" },
        "inventory": { "type": "boolean" },
        "foodCost": { "type": "boolean" },
        "facturacion": { "type": "boolean" },
        "nomina": { "type": "boolean" },
        "agentesIA": { "type": "boolean" },
        "coach": { "type": "boolean" },
        "chatIA": { "type": "boolean" },
        "resenas": { "type": "boolean" },
        "giftCards": { "type": "boolean" }
      }
    },
    "accent_color": {
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "default_theme": {
      "enum": ["light", "dark"]
    },
    "logo_url": {
      "type": "string",
      "pattern": "^https?://.+"
    },
    "mesas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "iva_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Fracción, no porcentaje: 0.16, no 16"
    },
    "receipt_footer": {
      "type": "string",
      "maxLength": 300
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "phone": {
      "type": "string",
      "pattern": "^[0-9+()\\- ]{7,20}$"
    },
    "rfc": {
      "type": "string",
      "pattern": "^[A-ZÑ&]{3,4}[0-9]{6}[A-Z0-9]{3}$",
      "description": "RFC mexicano (persona moral o física)"
    },
    "razon_social": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "support_email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "business_context": {
      "type": "string",
      "maxLength": 2000
    },
    "data_source": {
      "enum": ["fullsite", "wansoft", "demo", "supabase"],
      "description": "'supabase' aparece en manifests reales (amalay.json) aunque restaurant-manifest.ts no lo liste — mantener hasta reconciliar el union type"
    },
    "wansoft_subsidiary_id": {
      "type": "string",
      "minLength": 1
    },
    "telegram_chat_id_owner": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "report_recipients": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Record<string, string[]> según RestaurantManifest"
    },
    "staff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": { "enum": ["dueño", "gerente", "capitan", "cajero", "mesero", "staff"] },
          "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
          "pin": { "type": "string", "pattern": "^[0-9]{4,8}$" }
        }
      }
    },
    "station_routing": {
      "type": "object",
      "required": ["cocina", "barra", "caja"],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,30}$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location_display": { "type": "string", "minLength": 1, "maxLength": 200 },
        "owner_context": { "type": "string", "maxLength": 500 },
        "staff_names": { "type": "string", "maxLength": 500 }
      }
    },
    "terminals": {
      "type": "array",
      "minItems": 1,
      "description": "Gate R2-G04 / CLON-TERMINALS. Terminales físicas del cliente. generate_terminal_config.mjs emite un TerminalConfig (config.json de electron-app) por entrada — provisioning config-only, sin editar código.",
      "items": {
        "type": "object",
        "required": ["terminal_id", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "terminal_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{3,49}$",
            "description": "ID estable de la terminal física. Mínimo 4 chars (contrato de electron-app/local-server/config-schema.js)"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": {
            "enum": ["server_pos", "pos", "kds", "admin"],
            "description": "Debe coincidir con VALID_ROLES de config-schema.js"
          },
          "pos_server_ip": {
            "type": "string",
            "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$",
            "description": "IP LAN del server_pos — requerida para role kds (validación cruzada en el generador)"
          },
          "local_server_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "channel": { "enum": ["stable", "pilot", "development"] },
          "kds": {
            "type": "boolean",
            "description": "Abrir ventana KDS en segunda pantalla (solo server_pos)"
          },
          "printer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 },
            "description": "Subconjunto de printers[].printer_id asignado a esta terminal. Omitir = todas las impresoras del manifest."
          }
        }
      }
    },
    "printers": {
      "type": "array",
      "minItems": 1,
      "description": "Gate R2-G04 / CLON-TERMINALS. Impresoras físicas del cliente en formato espejo del schema v2 de electron-app/local-server/adapters/printer-config-schema.js. generate_terminal_config.mjs emite printers.json v2 por terminal POS.",
      "items": {
        "type": "object",
        "required": ["printer_id", "name", "connection", "station_ids"],
        "additionalProperties": false,
        "properties": {
          "printer_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,49}$",
            "description": "Máximo 50 chars (MAX_PRINTER_ID_LENGTH en printer-config-schema.js)"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "enabled": { "type": "boolean" },
          "connection": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["tcp", "usb", "windows"] },
              "host": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "names": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "station_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "document_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["kitchen_ticket", "bar_ticket", "receipt", "pre_ticket", "invoice", "corte", "reprint"]
            }
          },
          "copies": { "type": "integer", "minimum": 1, "maximum": 5 },
          "encoding": { "enum": ["cp850", "cp858", "utf-8"] }
        }
      }
    }
  }
}
