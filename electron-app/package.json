{
  "name": "fullsite-pos",
  "version": "1.3.9",
  "description": "Fullsite POS — kiosk wrapper for app.fullsite.mx/pos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "author": "Fullsite",
  "license": "UNLICENSED",
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "mx.fullsite.pos",
    "productName": "Fullsite POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
