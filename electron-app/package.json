{
  "name": "fullsite-pos",
  "version": "1.3.7",
  "description": "Fullsite POS — kiosk wrapper for app.fullsite.mx/pos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:pos": "electron-builder --win -c electron-builder-pos.json",
    "build:kds": "electron-builder --win -c electron-builder-kds.json"
  },
  "author": "Fullsite",
  "license": "UNLICENSED",
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "mx.fullsite.kds",
    "productName": "Fullsite KDS",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "fingerprint",
        "to": "fingerprint",
        "filter": [
          "**/*.exe",
          "**/*.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
