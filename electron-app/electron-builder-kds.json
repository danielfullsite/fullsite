{
  "appId": "mx.fullsite.kds",
  "productName": "Fullsite KDS",
  "beforePack": "./scripts/verify-offline-ui.cjs",
  "directories": {
    "output": "dist-kds"
  },
  "files": [
    "main.js",
    "build-info.json",
    "preload*.js",
    "setup.html",
    "offline.html",
    "icon.ico",
    "icon.png",
    "local-server/**/*.js",
    "local-server/core/permission-profiles.json",
    "local-server/kds-ui.html",
    "offline-ui/*.js",
    "ui-bundle/**/*",
    "update/*.js",
    "!**/tests/**",
    "!**/*.test.js",
    "!**/.env*",
    "!**/*.log",
    "!local-server/telemetry/latency-harness.js"
  ],
  "win": {
    "target": "nsis",
    "icon": "icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "danielfullsite",
      "repo": "fullsite",
      "releaseType": "release"
    }
  ]
}
