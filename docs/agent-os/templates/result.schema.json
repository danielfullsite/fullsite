{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOS Engineering Result",
  "type": "object",
  "required": ["task_id","submitted_by","submitted_at","verdict","summary"],
  "properties": {
    "task_id":      {"type": "string"},
    "submitted_by": {"type": "string"},
    "submitted_at": {"type": "string"},
    "verdict":      {"type": "string", "enum": ["VERIFIED","PARTIAL","FAILED","UNVERIFIED"]},
    "summary":      {"type": "string"},
    "evidence":     {"type": "string"},
    "commit":       {"type": ["string","null"]},
    "tests_passed": {"type": ["integer","null"]},
    "tests_total":  {"type": ["integer","null"]},
    "gaps_found":   {"type": "array", "items": {"type": "string"}},
    "next_steps":   {"type": "array", "items": {"type": "string"}}
  }
}
